{
  "name": "neofind-browser",
  "version": "0.1.24",
  "description": "NeoFind Browser for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "release:win": "electron-builder --win nsis --publish always",
    "prebuild:win": "node -e \"require('png-to-ico')('../icon_round.png').then(icon => require('fs').writeFileSync('icon.ico', icon))\""
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.0.0"
  },
  "build": {
    "appId": "pl.neofind.browser",
    "productName": "NeoFind Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "renderer.js",
      "style.css",
      "package.json",
      "icon.ico",
      "icon_round.png",
      "features-014.js",
      "features-015.js",
      "features-017.js"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NeoFind-Setup.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adyrianwilczek",
        "repo": "NeoFind",
        "releaseType": "prerelease"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
