rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================================================
       AUTH
       ========================================================= */

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn()
        && request.auth.uid == uid;
    }

    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "adrian.wilczek@hotmail.com",
          "michal.szyszynski@outlook.com",
          "account.neofind@gmail.com",
          "support.neofind@gmail.com",
          "michal.wilkowski@outlook.com",
          "michal.wilkowski@gmail.com",
          "j.e.wilkowska@gmail.com"
        ];
    }


    /* =========================================================
       NEOFIND
       ========================================================= */

    match /customResults/{doc} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bannedUsers/{email} {
      allow read: if isAdmin()
        || (
          isLoggedIn()
          && request.auth.token.email != null
          && request.auth.token.email.lower() == email.lower()
        );

      allow write: if isAdmin();
    }


    /* =========================================================
       GLOBAL ANNOUNCEMENTS
       ========================================================= */

    match /announcements/{announcementId} {

      /*
       * Każdy zalogowany użytkownik może czytać
       * globalne ogłoszenia.
       */

      allow read: if isLoggedIn();

      /*
       * Tylko administrator może tworzyć ogłoszenia
       * wysyłane do wszystkich.
       */

      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000;

      /*
       * Tylko administrator może edytować/usunąć
       * globalne ogłoszenie.
       */

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       USER ANNOUNCEMENTS
       ========================================================= */

    match /users/{userId}/announcements/{announcementId} {

      /*
       * Użytkownik może czytać tylko własne powiadomienia.
       * Admin może czytać wszystkie.
       */

      allow read: if isAdmin()
        || isOwner(userId);


      /*
       * Tworzenie powiadomień:
       *
       * 1. Admin może tworzyć dowolne powiadomienia.
       *
       * 2. Zalogowany użytkownik może tworzyć powiadomienia
       *    wymagane przez obecny frontend NeoFind.
       *
       * Ograniczamy dostępne pola i typy powiadomień.
       */

      allow create: if isAdmin()
        || (
          isLoggedIn()
          && request.resource.data.keys().hasOnly([
            'title',
            'body',
            'type',
            'from',
            'globalId',
            'createdAt',
            'read'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 5000
          && request.resource.data.type is string
          && request.resource.data.type in [
            'chat_message',
            'friend_request',
            'premium_purchase',
            'admin_orbs',
            'admin',
            'global',
            'system'
          ]
          && request.resource.data.read is bool
        );


      /*
       * Użytkownik może aktualizować własne powiadomienia,
       * ale nie może zmieniać ich właściciela.
       *
       * Admin może aktualizować wszystko.
       */

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.type == resource.data.type
          && request.resource.data.globalId == resource.data.globalId
          && request.resource.data.from == resource.data.from
          && request.resource.data.createdAt == resource.data.createdAt
        );


      /*
       * Użytkownik może usuwać swoje powiadomienia.
       * Admin może usuwać dowolne.
       */

      allow delete: if isAdmin()
        || isOwner(userId);
    }


    /* =========================================================
       FRIEND REQUESTS
       ========================================================= */

    match /friendRequests/{reqId} {

      allow read: if isLoggedIn()
        && (
          resource.data.from == request.auth.token.email
          || resource.data.to == request.auth.token.email
        );

      allow create: if isLoggedIn()
        && request.resource.data.from == request.auth.token.email;

      allow update: if isLoggedIn()
        && resource.data.to == request.auth.token.email;

      allow delete: if isAdmin()
        || (
          isLoggedIn()
          && (
            resource.data.from == request.auth.token.email
            || resource.data.to == request.auth.token.email
          )
        );
    }


    /* =========================================================
       CHATS
       ========================================================= */

    match /chats/{chatId} {

      allow read, write: if isLoggedIn()
        && (
          chatId.split('__')[0] == request.auth.token.email
          || chatId.split('__')[1] == request.auth.token.email
        );
    }

    match /chats/{chatId}/messages/{msgId} {

      function isParticipant() {
        return isLoggedIn()
          && (
            chatId.split('__')[0] == request.auth.token.email
            || chatId.split('__')[1] == request.auth.token.email
          );
      }

      allow read: if isParticipant();

      allow create: if isParticipant()
        && request.resource.data.from == request.auth.token.email;

      allow update, delete: if isParticipant()
        && resource.data.from == request.auth.token.email;
    }


    /* =========================================================
       SUPPORT CHATS
       ========================================================= */

    match /supportChats/{chatId} {

      allow read, update, delete: if isAdmin();

      allow create: if isLoggedIn()
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.status == "open";

      allow read: if isLoggedIn()
        && resource.data.userEmail == request.auth.token.email;

      allow update: if isLoggedIn()
        && resource.data.userEmail == request.auth.token.email
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.status == resource.data.status;


      match /messages/{msgId} {

        allow read: if isAdmin();

        allow read: if isLoggedIn()
          && get(
            /databases/$(database)/documents/supportChats/$(chatId)
          ).data.userEmail == request.auth.token.email;

        allow create: if isAdmin()
          && request.resource.data.from == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow create: if isLoggedIn()
          && get(
            /databases/$(database)/documents/supportChats/$(chatId)
          ).data.userEmail == request.auth.token.email
          && request.resource.data.from == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update, delete: if false;
      }
    }


    /* =========================================================
       RATINGS
       ========================================================= */

    match /ratings/{doc} {
      allow read, create: if isLoggedIn();
      allow delete: if isAdmin();
    }


    /* =========================================================
       REPORTS
       ========================================================= */

    match /reports/{doc} {
      allow create: if isLoggedIn();
      allow read, delete: if isAdmin();
    }


    /* =========================================================
       USERS
       ========================================================= */

    match /users/{userId} {

      /*
       * Orbs i Premium: właściciel nie może ich zmieniać dowolnie,
       * tylko w czterech scenariuszach z frontendu (start konta, skrzynia,
       * misja, zakup Premium). Admin może wszystko (przyznawanie orbs).
       */

      function economyKeys() {
        return [
          'orbs', 'premium', 'premiumUntil',
          'dailyChestDate', 'lastChestAt', 'lastDailyChestReward',
          'missionDay', 'missionClaims',
          'lastAdminOrbGrant'
        ];
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function emailOk(keys) {
        return !keys.hasAny(['email'])
          || request.resource.data.email == request.auth.token.email;
      }

      function oldOrbs() {
        return resource.data.get('orbs', 0);
      }

      function newOrbs() {
        return request.resource.data.get('orbs', 0);
      }

      function orbsValid() {
        return newOrbs() is int && newOrbs() >= 0;
      }

      function nowMs() {
        return request.time.toMillis();
      }

      function utcDay() {
        return math.floor(nowMs() / 86400000);
      }

      /* 1. pierwszy zapis salda: zawsze 0 */
      function isStartBalance() {
        return changedKeys().hasOnly(['orbs', 'email'])
          && !('orbs' in resource.data)
          && newOrbs() == 0;
      }

      /* 2. skrzynia dnia: co najmniej 12 h od poprzedniej, max 250 orbs albo 7 dni Premium */
      function isDailyChest() {
        let premiumBase = resource.data.get('premiumUntil', 0) > nowMs()
          ? resource.data.get('premiumUntil', 0)
          : nowMs();
        return changedKeys().hasOnly([
            'dailyChestDate', 'lastChestAt', 'lastDailyChestReward',
            'orbs', 'premiumUntil', 'email'
          ])
          && request.resource.data.lastChestAt == request.time
          && (
            !('lastChestAt' in resource.data)
            || request.time > resource.data.lastChestAt + duration.value(12, 'h')
          )
          && request.resource.data.dailyChestDate is string
          && orbsValid()
          && newOrbs() - oldOrbs() >= 0
          && newOrbs() - oldOrbs() <= 250
          && (
            !changedKeys().hasAny(['premiumUntil'])
            || (
              request.resource.data.premiumUntil is int
              && request.resource.data.premiumUntil <= premiumBase + 7 * 86400000 + 600000
            )
          );
      }

      /* 3. nagroda za misję: max 500 orbs, max 6 nagród na dobę (UTC) */
      function isMissionReward() {
        let previousClaims = resource.data.get('missionDay', -1) == utcDay()
          ? resource.data.get('missionClaims', 0)
          : 0;
        return changedKeys().hasOnly(['orbs', 'missionDay', 'missionClaims', 'email'])
          && request.resource.data.missionDay == utcDay()
          && request.resource.data.missionClaims == previousClaims + 1
          && request.resource.data.missionClaims <= 6
          && orbsValid()
          && newOrbs() - oldOrbs() > 0
          && newOrbs() - oldOrbs() <= 500;
      }

      /* 4. zakup Premium: dokładnie 1000 orbs za 30 dni */
      function isPremiumPurchase() {
        let premiumBase = resource.data.get('premiumUntil', 0) > nowMs()
          ? resource.data.get('premiumUntil', 0)
          : nowMs();
        return changedKeys().hasOnly(['orbs', 'premiumUntil', 'email'])
          && orbsValid()
          && newOrbs() == oldOrbs() - 1000
          && request.resource.data.premiumUntil is int
          && request.resource.data.premiumUntil > nowMs()
          && request.resource.data.premiumUntil <= premiumBase + 30 * 86400000 + 600000;
      }

      allow read: if isAdmin()
        || isOwner(userId);

      allow create: if isAdmin()
        || (
          isOwner(userId)
          && emailOk(request.resource.data.keys())
          && !request.resource.data.keys().hasAny([
            'premium', 'premiumUntil',
            'dailyChestDate', 'lastChestAt', 'lastDailyChestReward',
            'missionDay', 'missionClaims',
            'lastAdminOrbGrant'
          ])
          && request.resource.data.get('orbs', 0) == 0
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && emailOk(changedKeys())
          && (
            !changedKeys().hasAny(economyKeys())
            || isStartBalance()
            || isDailyChest()
            || isMissionReward()
            || isPremiumPurchase()
          )
        );

      /* usunięcie dokumentu kasowałoby też kontrolę rodzicielską */
      allow delete: if isAdmin();
    }


    /* =========================================================
       MAIL
       ========================================================= */

    match /mail/{mailId} {
      allow create: if isLoggedIn();
    }


    /* =========================================================
       ALERTS
       ========================================================= */

    match /alerts/{alertId} {

      allow create: if isLoggedIn()
        && request.resource.data.keys().hasOnly([
          'email',
          'type',
          'description',
          'timestamp'
        ])
        && request.resource.data.type is string
        && request.resource.data.description is string;

      allow read, delete: if isAdmin();
    }


    /* =========================================================
       API KEYS
       ========================================================= */

    match /api_keys/{keyId} {

      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.userId == request.auth.uid
        );
    }


    /* =========================================================
       NEO SOCIAL
       PROFILES
       ========================================================= */

    match /socialProfiles/{userId} {

      allow read: if true;

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        || isAdmin();

      allow delete: if isAdmin();
    }


    /* =========================================================
       NEO SOCIAL
       POSTS
       ========================================================= */

    match /socialPosts/{postId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow delete: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }


    /* =========================================================
       NEO SOCIAL
       REELS
       ========================================================= */

    match /socialReels/{reelId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow delete: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }


    /* =========================================================
       NEO SOCIAL
       FOLLOWS
       ========================================================= */

    match /socialFollows/{followId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid;

      allow update: if isLoggedIn()
        && resource.data.uid == request.auth.uid;

      allow delete: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }


    /* =========================================================
       NEO SOCIAL
       LIKES
       ========================================================= */

    match /socialLikes/{likeId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }


    /* =========================================================
       NEO SOCIAL
       COMMENTS
       ========================================================= */

    match /socialComments/{commentId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['post', 'reel']
        && request.resource.data.targetId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow update: if isLoggedIn()
        && resource.data.uid == request.auth.uid;

      allow delete: if isLoggedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }


    /* =========================================================
       NEO SOCIAL
       MODERATION
       ========================================================= */

    match /socialModeration/{moderationId} {

      allow read: if isAdmin();

      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       DEFAULT DENY
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}